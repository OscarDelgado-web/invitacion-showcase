# ==============================================================================
# RETOS Showcase 2026 — Plantilla de Variables de Entorno (.env.example)
#
# INSTRUCCIONES:
# 1. Copia este archivo con el nombre `.env` en este mismo directorio.
# 2. Completa los valores vacíos con los datos obtenidos en tu panel de Supabase:
#    Project Settings > API > Project URL & Project API Keys (service_role).
# 3. NUNCA subas el archivo `.env` al repositorio de Git.
# 4. En Vercel: Configura estas mismas variables en:
#    Project Settings > Environment Variables.
# ==============================================================================

# URL base del proyecto en Supabase (ejemplo: https://xyzcompany.supabase.co)
SUPABASE_URL=

# Llave de rol de servicio de Supabase (service_role secret).
# ADVERTENCIA: Esta llave otorga permisos de administrador para bypass de RLS.
# Solo debe residir en el entorno seguro de la función serverless en Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Contraseña administrativa estática para acceso al Dashboard y Control de Acceso
# Valor por defecto si no se especifica: contraseniaParaDashboard123@!
DASHBOARD_PASSWORD=contraseniaParaDashboard123@!
