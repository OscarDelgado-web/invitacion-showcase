# ==============================================================================
# RETOS Showcase 2026 — Git Ignore
# ==============================================================================

# Variables de entorno y secretos (la llave de servicio nunca se sube al repositorio)
.env*
!.env.example

# Directorio de despliegue de Vercel
.vercel

# Dependencias y logs de Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Archivos de sistema y editores
.DS_Store
Thumbs.db
*.bak
*.tmp
*.swp
.idea/
.vscode/
